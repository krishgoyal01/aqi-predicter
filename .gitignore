# ===== Data =====
# Raw data is large and reproducible from Kaggle - don't commit it
data/raw/*
!data/raw/.gitkeep

# Keep processed data out too unless you specifically want to version it
data/processed/*
!data/processed/.gitkeep

# ===== Models =====
# Trained model files can get large - optional to ignore, your call
#models/*.pkl
models/model_rf.pkl
models/model_lr.pkl
